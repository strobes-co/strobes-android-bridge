<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cds_background">

    <!-- Header: brand mark + wordmark, same lockup as the web platform.
         Lives above the tabs (always visible) rather than inside either
         tab's scrollable content. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_brand_mark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/cds_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_capability_table"
            style="@style/Widget.StrobesBridge.Button.Compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/action_capability_table" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_setup_guide"
            style="@style/Widget.StrobesBridge.Button.Compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_setup_guide" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cds_background"
        app:tabIndicatorColor="@color/cds_button_primary"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/cds_text_primary"
        app:tabTextColor="@color/cds_text_secondary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <ScrollView
        android:id="@+id/status_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="20dp">

        <!-- Bridge details only: connection status, a link to the fuller
             device-status screen (root/automation/proxy/CA/capture-count —
             see DeviceStatusActivity), pairing fields, one toggle button.
             Everything else lives one tap away instead of stacked here. -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <View
                android:id="@+id/status_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_dot" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/status_not_paired"
                android:textColor="@color/cds_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/cds_border_subtle_00" />

        <LinearLayout
            android:id="@+id/row_device_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_device_status"
                android:textColor="@color/cds_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/cds_text_helper"
                android:textSize="18sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp"
            android:background="@color/cds_border_subtle_00" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/test_device_warning_short"
            android:textColor="@color/cds_support_warning"
            android:textSize="11sp" />

        <!-- Pairing section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:letterSpacing="0.08"
            android:text="@string/section_pairing"
            android:textAllCaps="true"
            android:textColor="@color/cds_text_helper"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/hint_server_url">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_server_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:textColor="@color/cds_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/hint_org_id">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_org_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/cds_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/hint_api_key">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/cds_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:hint="@string/hint_shell_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_shell_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/cds_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Single toggle — flips label/action based on
             BridgeForegroundService#status (see MainActivity#renderStatus). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_bridge"
            style="@style/Widget.StrobesBridge.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_start" />

    </LinearLayout>
    </ScrollView>

    <!-- Traffic tab: hosts grouped from the same live capture data an
         agent's android_proxy_history tool reads (ProxyController.history).
         Tapping a host drills into TrafficHostActivity, then a request into
         TrafficDetailActivity — see HostAdapter/TrafficAdapter. -->
    <LinearLayout
        android:id="@+id/traffic_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/traffic_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/traffic_empty"
            android:textColor="@color/cds_text_helper"
            android:textSize="13sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/traffic_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />

    </LinearLayout>

    </FrameLayout>
</LinearLayout>
